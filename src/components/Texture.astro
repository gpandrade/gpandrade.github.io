---
import { staticLines } from '../lib/texture';
import { site } from '../site';

/**
 * The background texture. The inline SVG is the frame that exists without JS and under prefers-reduced-motion:
 * straight kagome lines at true scale (no viewBox, so nothing is rescaled), large enough for any viewport. With JS
 * and motion allowed, the script swaps in a canvas driven by the engine in src/lib/texture.ts, which starts from the
 * same rest lattice so the handover is invisible. The engine instance is exposed as `window.texture`; the easter egg
 * (src/lib/egg.ts) calls it. This script also arms the egg's trigger (src/lib/egg-trigger.ts), which generates the
 * nodes through the page by the density rule in site.nodes, so the page makes one script request either way.
 */
const d = staticLines(4096, 2560);
const nodes = site.egg ? [site.nodes.every[0], site.nodes.every[1], site.nodes.out, site.nodes.max].join(' ') : undefined;
---
<svg class="texture" aria-hidden="true" focusable="false" data-texture data-variant={site.textureVariant} data-idle={site.textureIdle ? '' : undefined} data-nodes={nodes}>
  <path d={d} />
</svg>

<script>
  import { createTexture } from '../lib/texture';
  import { armEgg } from '../lib/egg-trigger';

  const svg = document.querySelector<SVGSVGElement>('svg[data-texture]');
  if (svg && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const canvas = document.createElement('canvas');
    canvas.className = 'texture';
    canvas.setAttribute('aria-hidden', 'true');
    svg.replaceWith(canvas);
    window.texture = createTexture(canvas, {
      variant: svg.dataset.variant === 'conservative' ? 'conservative' : 'full',
      idle: svg.dataset.idle !== undefined,
    });
  }

  const rule = svg?.dataset.nodes?.split(' ').map(Number);
  if (rule?.length === 4) armEgg({ every: [rule[0]!, rule[1]!], out: rule[2]!, max: rule[3]! });
</script>
